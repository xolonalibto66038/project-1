msgid ""
"These Terms of Service are governed by the laws of the People's Democratic "
"Republic of Algeria."
msgstr "تخضع شروط الخدمة هذه لقوانين الجمهورية الجزائرية الديمقراطية الشعبية."

#: .\apps\pages\views\terms.py:217
msgid ""
"Any disputes arising from these terms shall be subject to the exclusive "
